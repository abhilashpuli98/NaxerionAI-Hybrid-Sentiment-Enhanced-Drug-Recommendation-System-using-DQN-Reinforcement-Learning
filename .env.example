# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY="replace-with-a-random-secret-before-running"
debug=True

# Database
DATABASE_URI=sqlite:///instance/sedrs.db

# Model Configuration
BERT_MODEL=distilbert-base-uncased
WEIGHT_TEXT=0.4
WEIGHT_AUDIO=0.35
WEIGHT_IMAGE=0.25

# System
LOG_LEVEL=INFO
